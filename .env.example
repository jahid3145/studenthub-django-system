# Django Settings
SECRET_KEY=django-insecure-studenthub-local-dev-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*

# Database Settings (Supports SQLite, MySQL, or PostgreSQL)
DB_ENGINE=sqlite  # Options: sqlite, mysql, postgres
USE_MYSQL=False
USE_POSTGRES=False
DB_NAME=studenthub_db
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306  # 3306 for MySQL, 5432 for PostgreSQL

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
